[Desktop Entry]
Type=Application
Name=Rusty Teams
GenericName=Microsoft Teams client
Comment=A fast, native Microsoft Teams chat client
Exec=teams
TryExec=teams
Icon=rusty-teams
# Matches the window's app id (LINUX_APP_ID in crates/app/src/main.rs), so docks pair the
# window with this entry; the app writes the same id when it installs itself (linux_desktop.rs).
StartupWMClass=rusty-teams
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=Teams;Chat;Microsoft;
# AppRun registers the desktop entry and icons itself; tell external AppImage
# integrators (AppImageLauncher, appimaged) not to add a duplicate.
X-AppImage-Integrate=false
