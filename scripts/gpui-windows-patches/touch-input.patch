diff -ruN a/src/touch.rs b/src/touch.rs
--- a/src/touch.rs
+++ b/src/touch.rs
@@ -0,0 +1,41 @@
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+
+use gpui::{Pixels, Point, TouchId, TouchPhase};
+
+#[derive(Default)]
+pub(crate) struct TouchPointers {
+    next_touch_id: Cell<u64>,
+    active: RefCell<HashMap<u32, (TouchId, Point<Pixels>)>>,
+}
+
+impl TouchPointers {
+    pub(crate) fn track(
+        &self,
+        pointer_id: u32,
+        phase: TouchPhase,
+        position: Point<Pixels>,
+    ) -> Option<TouchId> {
+        let mut active = self.active.borrow_mut();
+        match phase {
+            TouchPhase::Started => {
+                let touch_id = TouchId(self.next_touch_id.get());
+                self.next_touch_id.set(self.next_touch_id.get() + 1);
+                active.insert(pointer_id, (touch_id, position));
+                Some(touch_id)
+            }
+            TouchPhase::Moved => {
+                let entry = active.get_mut(&pointer_id)?;
+                entry.1 = position;
+                Some(entry.0)
+            }
+            TouchPhase::Ended | TouchPhase::Cancelled => {
+                active.remove(&pointer_id).map(|(touch_id, _)| touch_id)
+            }
+        }
+    }
+
+    pub(crate) fn cancel(&self, pointer_id: u32) -> Option<(TouchId, Point<Pixels>)> {
+        self.active.borrow_mut().remove(&pointer_id)
+    }
+}
